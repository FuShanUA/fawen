# GLM engine config (DashScope / Aliyun)
# Copy to .env.glm and fill in your values

DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
GLM_MODEL=glm-5.2
VL_MODEL=qwen-vl-max
GLM_MAX_TOKENS=16000
VL_MAX_TOKENS=300
DCMM_MAX_WORKERS=5

# Shared data root (enterprise PDFs, enterprise list)
# DCMM_DATA_ROOT=/Users/shanfu/Desktop/audit_batch
