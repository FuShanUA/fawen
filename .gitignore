# === PostOS 2.0 仓库 .gitignore ===

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 敏感配置（本地保留，不进仓库）
.env

# 备份与临时文件
*.bak
*.bak_*
*.log
.DS_Store

# 独立子项目（各自有独立仓库，PostOS 仓库不跟踪）
# autosub -> FuShanUA/autosub | DCMM -> FuShanUA/DCMMShenji
Library/Tools/
Projects/
.agents/
.claude/
.tools/
wip/

# cc 项目记忆文件（本地保留，不进 PostOS 仓库）
AGENTS.md
CLAUDE.md
